{
  "name": "@opencontract/cli",
  "version": "1.0.0",
  "description": "Markdown-first contract system and CLI for agent-driven work",
  "type": "module",
  "bin": {
    "opencontract": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc && node scripts/verify-resources.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "type-check": "tsc --noEmit",
    "validate:skills": "node scripts/validate-skills.mjs"
  },
  "files": [
    "dist",
    "resources",
    "README.md",
    "README-Concept.md",
    "LICENSE"
  ],
  "keywords": [
    "opencontract",
    "agent",
    "contract",
    "markdown",
    "validation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chentianrong/OpenContract.git"
  },
  "homepage": "https://github.com/chentianrong/OpenContract#readme",
  "bugs": {
    "url": "https://github.com/chentianrong/OpenContract/issues"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/semver": "^7.8.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "gray-matter": "^4.0.3",
    "mdast-util-to-string": "^4.0.0",
    "remark": "^15.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "semver": "^7.8.5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  }
}
